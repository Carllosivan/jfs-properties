{
    "name": "jfsproperties/jfs-properties",
    "description": "Sistema Integrado de Gestão Imobiliária, Incidentes e Manutenção",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*",
        "ext-json": "*",
        "ext-mbstring": "*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\": "database/"
        }
    },
    "scripts": {
        "migrate": "php database/run.php",
        "serve": "php -S 0.0.0.0:8000 -t public public/index.php"
    }
}
